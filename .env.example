# Supabase — stesso progetto di BHM-v.2 (ref: hjteuounjwkadmsbsmdm)
# Copia questo file in .env.local e compila i valori.
# Dashboard: https://supabase.com/dashboard/project/hjteuounjwkadmsbsmdm/settings/api

VITE_SUPABASE_URL=https://hjteuounjwkadmsbsmdm.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Solo per script di verifica / test DB (NON esporre al frontend)
SUPABASE_SERVICE_KEY=your_service_role_key

# Password DB Postgres (Dashboard → Settings → Database). Necessaria perché
# l'account CLI corrente non ha privilegi management sul progetto: db pull,
# migration list e gen types passano dalla connessione diretta (scripts/sb.mjs).
SUPABASE_DB_PASSWORD=your_db_password

# Test E2E (quando l'app esiste)
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password
BASE_URL=http://localhost:3000

# Opzionali (beta)
VITE_SENTRY_DSN=
NODE_ENV=development
