{
  "name": "bhm-zen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BHM rilancio — repo pulita (HACCP PWA)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run type-check && npm run test",
    "verify:setup": "node scripts/verify-setup.mjs",
    "verify:supabase-cli": "node scripts/verify-supabase-cli.mjs",
    "verify:supabase-env": "node scripts/verify-supabase-env.mjs",
    "verify:legacy": "node scripts/verify-legacy.mjs",
    "verify:flows": "node scripts/verify-flows.mjs",
    "verify:flows:write": "node scripts/verify-flows.mjs --write",
    "supabase:link": "node scripts/sb.mjs link --project-ref hjteuounjwkadmsbsmdm",
    "supabase:status": "node scripts/sb.mjs projects list",
    "supabase:tables": "node scripts/sb.mjs inspect db table-stats --linked",
    "supabase:pull": "node scripts/sb.mjs db pull",
    "supabase:types": "node scripts/supabase-types.mjs",
    "supabase:migrations": "node scripts/sb.mjs migration list"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.62.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
